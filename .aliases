# bash aliases taken from previous Ubuntu & current Arch install

alias please="sudo"

alias zoop="echo '👉😎👉 ~Zoop!~' | lolcat"

alias moo="fortune | cowsay | lolcat"
alias tux="fortune | cowsay -f tux | lolcat"
#alias gnu="fortune | cowsay -f gnu | lolcat"

#alias besterm="export FBTERM_BACKGROUND_IMAGE=1 && cat $HOME/Pictures/desktops/space.fbimg > /dev/fb0; fbterm -s 28 -n "Hack""
#alias whtfnt="echo -en "\e]P7ffffff" && clear"

alias davefetch='neofetch --ascii "$HOME/Pictures/asciis/hal"'
alias tuxfetch='neofetch --ascii "$HOME/Pictures/asciis/tux"'

alias dots="/usr/bin/git --git-dir=$HOME/.dots --work-tree=$HOME"

#alias lock="i3lock -i $HOME/Wallpapers/neon-nights.png -p win"

alias ls="ls --color=auto"
alias grep="grep --color=auto"
alias rs="ranger /home/quiterion/Skool/"

alias f='fzf | xargs -I{} vim -c "cd %:h" "{}"'

